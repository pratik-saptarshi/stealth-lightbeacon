# Drupal Evaluator Configuration

# Google PageSpeed Insights API Key (Optional, but recommended to avoid rate limits)
# Get a key from: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=your_pagespeed_api_key_here

# Canonical client/service contract defaults
SLB_SERVICE_HOST=127.0.0.1
SLB_SERVICE_PORT=8000
SLB_SERVICE_SCHEME=http
SLB_SERVICE_BASE_URL=http://127.0.0.1:8000
SLB_SERVICE_REMOTE_SCHEME=https
SLB_SERVICE_STDIN_ADAPTER=stdin
